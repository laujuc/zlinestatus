#!/bin/sh

set -eu

battery_type=${1:-battery}
zsendvalue_command=${ZSENDVALUE:-zsendvalue}

wait_seconds=5
if [ -r cfg/WAIT ]; then
    wait_seconds=$(head -n 1 cfg/WAIT)
fi

find_battery_dir() {
    for dir in /sys/class/power_supply/BAT*; do
        if [ -r "$dir/capacity" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    return 1
}

while :; do
    battery_dir=$(find_battery_dir || true)

    if [ -n "${battery_dir}" ] && [ -r "$battery_dir/status" ]; then
        capacity=$(head -n 1 "$battery_dir/capacity")
        status=$(head -n 1 "$battery_dir/status" | tr '[:upper:] ' '[:lower:]-')

        case "$status" in
            charging)
                "$zsendvalue_command" -type "$battery_type" "$capacity" charging battery ac
                ;;
            full)
                "$zsendvalue_command" -type "$battery_type" "$capacity" full battery ac
                ;;
            discharging)
                "$zsendvalue_command" -type "$battery_type" "$capacity" discharging battery
                ;;
            *)
                "$zsendvalue_command" -type "$battery_type" "$capacity" "$status" battery
                ;;
        esac
    else
        "$zsendvalue_command" -type "$battery_type" 0 ac
    fi

    sleep "$wait_seconds"
done
