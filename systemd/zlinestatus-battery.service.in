[Unit]
Description=zlinestatus battery updater
BindsTo=zlinestatus@battery.service
After=zlinestatus@battery.service

[Service]
Type=simple
WorkingDirectory=@prefix@/share/zlinestatus
Environment=ZSENDVALUE=@prefix@/bin/zsendvalue
ExecStart=@prefix@/share/zlinestatus/scripts/battery
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
