[Unit]
Description=zlinestatus instance for %i
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Environment=ZLINESTATUS=@prefix@/bin/zlinestatus
Environment=ZSENDVALUE=@prefix@/bin/zsendvalue
Environment=WAIT=5
ExecStart=@prefix@/share/zlinestatus/scripts/zlinestatus-instance %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
